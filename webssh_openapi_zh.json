                          "content" : {
                            "description" : "Base64 编码的文件内容",
                            "format" : "byte",
                            "type" : "string"
                          },
                          "mime_type" : {
                            "description" : "文件的 MIME 类型",
                            "type" : "string"
                          },
                          "name" : {
                            "description" : "文件名",
                            "type" : "string"
                          }
                        },
                        "type" : "object"
                      },
                      "type" : "array"
                    }
                  },
                  "type" : "object"
                }
              }
            },
            "description" : "结构化响应"
          }
        },
        "summary" : "WebSSH_Version",
        "x-openai-isConsequential" : false
      }
    },
